---
// src/components/HeroCarousel.astro

const destinations = [
    { name: 'Kraków', filenameKey: 'krakow' },
    { name: 'Warszawa', filenameKey: 'warszawa' },
    { name: 'Kołobrzeg', filenameKey: 'kolobrzeg' },
    { name: 'Budapeszt', filenameKey: 'budapeszt' },
    { name: 'Praga', filenameKey: 'praga' },
    { name: 'Wrocław', filenameKey: 'wroclaw' },
    { name: 'Wenecja', filenameKey: 'wenecja' },
    { name: 'Paryż', filenameKey: 'paryz' }
];

// Pobieramy wszystkie obrazy z folderu dest/
const imageFiles = import.meta.glob('/src/assets/dest/*.{jpeg,jpg,png,webp}', { eager: true });

// Łączymy dane
const slides = destinations.map(dest => {
    const fileKey = Object.keys(imageFiles).find(path => 
        path.toLowerCase().includes(dest.filenameKey.toLowerCase())
    );
    const imgModule = fileKey ? imageFiles[fileKey] : null;
    const imageSrc = imgModule ? (imgModule as any).default?.src || (imgModule as any).default : '';
    
    return { ...dest, imageSrc };
});
---

<div class="dest-carousel">
    {slides.map((slide, index) => (
        <div class={`dest-slide ${index === 0 ? 'active' : ''}`}>
            
            <div class="dest-img-mask">
                {slide.imageSrc ? (
                    <img src={slide.imageSrc} alt={`Flota Pas-Trans - ${slide.name}`} class="dest-img" loading={index === 0 ? "eager" : "lazy"} />
                ) : (
                    <div class="dest-img-placeholder">Brak zdjęcia</div>
                )}
            </div>

        </div>
    ))}
</div>

<style>
    /* --- GŁÓWNY KONTENER --- */
    .dest-carousel {
        position: relative;
        width: 100%; 
        height: 100%; /* Zajmuje 100% wysokości hero-img (czyli całej sekcji hero) */
        background-color: transparent; 
        margin: 0;
    }

    /* --- SLAJDY I PŁYNNE PRZEJŚCIA --- */
    .dest-slide {
        position: absolute;
        inset: 0;
        display: flex;
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease-in-out, visibility 1.2s ease-in-out;
    }

    .dest-slide.active {
        opacity: 1;
        visibility: visible;
    }

    /* --- KSZTAŁT (GŁĘBOKI ŁUK, NIE UCIĘTY) --- */
    .dest-img-mask {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0; 
        left: -20%; /* Rozciągamy maskę mocno w lewo, żeby koło było pełne i wjeżdżało pod tekst */
        width: 120%; /* Zapas szerokości na narysowanie pełnego, nieuciętego koła */
        /* Idealnie narysowane koło przyklejone do prawej krawędzi */
        clip-path: circle(75% at 100% 50%); 
        z-index: 1;
        /* Brak cienia! Cień na tak wielkich, absolutnych elementach w połączeniu z flexboxem powoduje overflow */
    }

    /* OCHRONA PRZED GLOBALNYM CSS */
    div.dest-img-mask img.dest-img {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: cover !important;
        border-radius: 0 !important; /* Przy prawej krawędzi okna jest prosto */
        box-shadow: none !important;
        transform: scale(1.15) !important;
        transition: transform 6s ease-out !important; 
    }

    .dest-slide.active div.dest-img-mask img.dest-img {
        transform: scale(1) !important;
    }

    .dest-img-placeholder {
        width: 100%;
        height: 100%;
        background: #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #777;
    }
    @media (max-width: 992px) {
        .dest-carousel {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.dest-slide');
        if (slides.length <= 1) return;

        let currentIndex = 0;
        
        setInterval(() => {
            slides[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % slides.length;
            slides[currentIndex].classList.add('active');
        }, 4500); 
    });
</script>